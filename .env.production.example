# ==========================================
# Affordz Admin & Vendor Web Production Environment Variables
# Copy to .env.production (or configure in Vercel) before deployment (Decision D-025)
# ==========================================

NODE_ENV=production
PORT=3000

# Backend REST API endpoint URL
NEXT_PUBLIC_API_URL="https://api.affordz.com/api/v1"

# Firebase Authentication Web SDK Config (Decision D-017, public client config)
NEXT_PUBLIC_FIREBASE_API_KEY="[YOUR_FIREBASE_API_KEY]"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="kudikart-3ec2e.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="kudikart-3ec2e"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="kudikart-3ec2e.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="[YOUR_FIREBASE_MESSAGING_SENDER_ID]"
NEXT_PUBLIC_FIREBASE_APP_ID="[YOUR_FIREBASE_APP_ID]"

# Sentry Web Monitoring (Decision D-023)
NEXT_PUBLIC_SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]"
# Optional server-side fallback if different from NEXT_PUBLIC_SENTRY_DSN:
# SENTRY_DSN=""
