# ==========================================
# KudiCart Admin & Vendor Web Production Environment Variables
# Copy to .env.production before deployment to Vercel (Decision D-025)
# ==========================================

NODE_ENV=production
PORT=3000

# Backend REST API endpoint URL
NEXT_PUBLIC_API_URL="https://api.affordz.com/api/v1"

# Sentry Web Monitoring (Decision D-023)
NEXT_PUBLIC_SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]"

# Razorpay Client Public Key
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_[YOUR_LIVE_KEY_ID]"
